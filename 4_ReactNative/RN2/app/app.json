{
  "expo": {
    "name": "SensorLab",
    "slug": "sensorlab",
    "scheme": "sensorlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pdeisc.sensorlab"
    },
    "android": {
      "package": "com.pdeisc.sensorlab",
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon-oscuro.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SensorLab usa la cámara para sacar fotos y escanear códigos.",
          "microphonePermission": "SensorLab usa el micrófono para grabar video con sonido.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SensorLab usa tu ubicación para mostrar el GPS en vivo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SensorLab accede a tus fotos para mostrarlas.",
          "cameraPermission": "SensorLab usa la cámara para sacar fotos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SensorLab usa Face ID para verificar tu identidad."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c13b2ce-484f-4e29-90b8-7e6877058c41"
      }
    },
    "owner": "parahacer"
  }
}
